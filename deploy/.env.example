# Image tags: the full commit SHA each repository's CI published.
# They are separate repositories, so the two SHAs differ.
AICFES_API_TAG=
AICFES_WEB_TAG=

# Hosts served by Traefik.
API_HOST=aicfes-backend.deviego.xyz
WEB_HOST=aicfes.deviego.xyz

# Secrets. Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=

# The model provider. Never commit this file with a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# The verifier runs on a different model family than the generator. A
# model checking its own work shares its blind spots; two families fail
# differently, so their agreement is evidence rather than an echo.
# Without this key verification still runs, on one family only.
ANTHROPIC_API_KEY=
ANTHROPIC_VERIFIER_MODEL=claude-opus-5-5

# Set to false to skip verification entirely, for a cheaper local run.
VERIFY_ANSWERS=true

# Above this cosine similarity two questions count as the same.
DEDUP_THRESHOLD=0.92
