# Image tags: the full commit SHA each repository's CI published.
# They are separate repositories, so the two SHAs differ.
AICFES_API_TAG=
AICFES_WEB_TAG=

# Hosts served by Traefik.
API_HOST=aicfes-backend.deviego.xyz
WEB_HOST=aicfes.deviego.xyz

# Secrets. Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=

# The model provider. Never commit this file with a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Verification runs on a model other than the one that generated the
# item: a model checking its own work shares its blind spots.
#
# Best is another family, which fails differently — set a key here and
# it is used. Without one, the verifier falls back to a more capable
# model from the same provider (OPENAI_VERIFIER_MODEL below). That
# shares post-training habits with the generator, but not its
# capability ceiling, which is what catches a confidently wrong answer.
ANTHROPIC_API_KEY=
ANTHROPIC_VERIFIER_MODEL=claude-opus-5-5

# The same-provider fallback. Larger than the generator on purpose.
# At roughly 400 tokens in and 30 out per item, this is about
# US$0.0008 per verification.
OPENAI_VERIFIER_MODEL=gpt-5

# Set to false to skip verification entirely, for a cheaper local run.
VERIFY_ANSWERS=true

# Above this cosine similarity two questions count as the same.
DEDUP_THRESHOLD=0.92
