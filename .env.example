OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
JWT_SECRET=
JWT_EXPIRES=7d
REFRESH_TOKEN_EXPIRES_DAYS=30
REFRESH_COOKIE_NAME=refresh_token
ACCESS_COOKIE_NAME=access_token
PORT=3000
MAX_ITEMS=20
MAX_RETRIES=2
BODY_LIMIT=1mb
CORS_ORIGIN=*
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
