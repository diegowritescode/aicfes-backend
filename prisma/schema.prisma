// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enum for areas
enum Area {
  MAT
  LC
  CN
  SOC
  ING
}

// Enum for difficulty
enum Dificultad {
  facil
  media
  alta
}

// Enum for generation request status
enum GenerationStatus {
  PENDING
  SUCCESS
  ERROR
}

// Enum for parse status (debugging)
enum ParseStatus {
  OK
  FAIL
}

enum StudyMode {
  generacion_libre
  contrarreloj
  test
}

enum MissionType {
  questions_by_area
  review_explanations
  time_trial_sessions
  review_test
  sessions_completed
}

enum MissionRecurrence {
  daily
  weekly
}

model User {
  id              String           @id @default(cuid())
  email           String?          @unique
  passwordHash    String?
  passwordSalt    String?
  timezone        String           @default("UTC")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  studySessions   StudySession[]
  xpEvents        XPEvent[]
  missionProgress MissionProgress[]
  refreshTokens   RefreshToken[]

  @@index([createdAt])
}

model StudySession {
  id               String     @id @default(cuid())
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode             StudyMode
  area             Area
  dificultad       Dificultad?
  tema             String?
  startedAt        DateTime
  endedAt          DateTime
  durationSeconds  Int
  totalQuestions   Int
  correctQuestions Int
  correctXpAwarded Int        @default(0)
  timeXpAwarded    Int        @default(0)
  lastHeartbeatAt  DateTime?
  answers          Answer[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([userId, endedAt])
  @@index([userId, area])
  @@index([userId, mode])
}

model Answer {
  id             String       @id @default(cuid())
  sessionId      String
  session        StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionIndex  Int
  area           Area?
  dificultad     Dificultad?
  selectedAnswer String?
  isCorrect      Boolean
  createdAt      DateTime     @default(now())

  @@index([sessionId])
}

model XPEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model MissionDefinition {
  id          String            @id @default(cuid())
  title       String
  description String?
  type        MissionType
  target      Int
  xpReward    Int
  recurrence  MissionRecurrence
  area        Area?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  progress    MissionProgress[]

  @@index([recurrence])
}

model MissionProgress {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionId   String
  mission     MissionDefinition @relation(fields: [missionId], references: [id], onDelete: Cascade)
  date        String
  progress    Int               @default(0)
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([userId, missionId, date])
  @@index([userId, date])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

// Generation request metadata
model GenerationRequest {
  id                    String   @id @default(cuid())
  requestId             String   @unique
  area                  Area
  dificultad            Dificultad
  tema                  String?
  plantilla             String?
  n                     Int      @default(1)
  status                GenerationStatus @default(PENDING)
  error                 String?
  rawModelOutput        String?  @db.Text         // Raw output from OpenAI (for debugging)
  parseStatus           ParseStatus?               // OK | FAIL
  parseError            String?                    // Parse error details
  normalizedItemsCount  Int      @default(0)       // Number of items parsed successfully
  items                 GeneratedItem[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([requestId])
  @@index([status])
  @@index([parseStatus])
  @@index([createdAt])
}

// Generated item (each question/item from AI)
model GeneratedItem {
  id                 String   @id @default(cuid())
  generationRequest  GenerationRequest @relation(fields: [requestId], references: [requestId], onDelete: Cascade)
  requestId          String
  area               Area
  dificultad         Dificultad
  plantilla          String
  contexto           String   @db.Text
  pregunta           String   @db.Text
  opciones           Json     // {A: string, B: string, C: string, D: string}
  respuesta_correcta String
  justificacion      String   @db.Text
  tags               Json     // array of strings
  distractores       Json     // {A: string, B: string, C: string, D: string} with error types
  explicaciones      Json?    // {A: string, B: string, C: string, D: string} with explanations
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([requestId])
  @@index([area])
  @@index([createdAt])
}
