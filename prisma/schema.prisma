// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enum for areas
enum Area {
  MAT
  LC
  CN
  SOC
  ING
}

// Enum for difficulty
enum Dificultad {
  facil
  media
  alta
}

// Enum for generation request status
enum GenerationStatus {
  PENDING
  SUCCESS
  ERROR
}

// Enum for parse status (debugging)
enum ParseStatus {
  OK
  FAIL
}

enum StudyMode {
  generacion_libre
  contrarreloj
  test
}

enum MissionType {
  questions_by_area
  review_explanations
  time_trial_sessions
  review_test
  sessions_completed
}

enum MissionRecurrence {
  daily
  weekly
}

model User {
  id              String           @id @default(cuid())
  email           String?          @unique
  passwordHash    String?
  passwordSalt    String?
  timezone        String           @default("UTC")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  studySessions   StudySession[]
  xpEvents        XPEvent[]
  missionProgress MissionProgress[]
  refreshTokens   RefreshToken[]
  feedbacks       Feedback[]
  debilidades     PerfilDebilidad[]

  @@index([createdAt])
  simulacros    Simulacro[]

}

model StudySession {
  id               String     @id @default(cuid())
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode             StudyMode
  area             Area
  dificultad       Dificultad?
  modeId           String?
  timeLimitSeconds Int?
  questions        Int?
  tema             String?
  startedAt        DateTime
  endedAt          DateTime
  durationSeconds  Int
  totalQuestions   Int
  correctQuestions Int
  correctXpAwarded Int        @default(0)
  timeXpAwarded    Int        @default(0)
  lastHeartbeatAt  DateTime?
  areaBreakdown    Json?
  answers          Answer[]
  feedback         Feedback?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([userId, endedAt])
  @@index([userId, area])
  @@index([userId, mode])
}

model TimeTrialMode {
  id              String   @id
  title           String
  description     String
  timeLimitSeconds Int
  questions       Int
  /// Null means "aim at whatever this learner is weakest in", which is
  /// the point of having a weakness profile at all.
  area            Area?
  dificultad      Dificultad?
  mix             Json?
  /// Where this sits in the ladder, so the interface can show how far
  /// along someone is instead of a flat list.
  nivel           Int      @default(1)
  /// Derived, but stored so the interface can show the pace without
  /// dividing, and so a mode cannot drift from what it claims.
  segundosPorPregunta Int  @default(64)
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([enabled])
}

model Feedback {
  id           String   @id @default(cuid())
  sessionId    String   @unique
  session      StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  summary      String
  strengths    Json
  weaknesses   Json
  plan         Json
  insights     Json
  generatedAt  DateTime
  model        String
  promptVersion String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, generatedAt])
}

model Answer {
  id             String       @id @default(cuid())
  sessionId      String
  session        StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionIndex  Int
  area           Area?
  dificultad     Dificultad?
  selectedAnswer String?
  isCorrect      Boolean
  /// Which item was answered. Without it the answer cannot be joined
  /// back to the question's topic or to the kind of mistake the chosen
  /// option represents, which is everything the weakness profile needs.
  /// Nullable because answers recorded before this existed have none.
  itemId         String?
  /// How long the learner took. A correct answer that took three
  /// minutes is not the same as one that took twenty seconds.
  tiempoMs       Int?
  createdAt      DateTime     @default(now())

  @@index([sessionId])
  @@index([itemId])
}

/// What a learner keeps getting wrong, and at what grain.
///
/// StudySession already says how a learner did in an area. That is too
/// coarse to act on: "flojo en Matemáticas" does not say whether the
/// problem is angles or percentages, and the whole point is to put the
/// right thing in front of them tomorrow.
///
/// One row per learner, area and topic. `tipoErrores` counts how often
/// each kind of mistake appeared — error_calculo,
/// interpretacion_parcial, confunde_conceptos — which the generator
/// already labels on every distractor and which was being thrown away.
model PerfilDebilidad {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  area         Area
  /// The topic, from the item's own tags: "angulos", "leyes de newton".
  tema         String
  respondidas  Int      @default(0)
  acertadas    Int      @default(0)
  /// {error_calculo: 3, confunde_conceptos: 1}
  tipoErrores  Json     @default("{}")
  /// Lets a weakness fade: what someone failed in March should not
  /// outrank what they failed last week.
  ultimoFallo  DateTime?
  actualizadoEn DateTime @updatedAt

  @@unique([userId, area, tema])
  @@index([userId, area])
}

model XPEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model MissionDefinition {
  id          String            @id @default(cuid())
  title       String
  description String?
  type        MissionType
  target      Int
  xpReward    Int
  recurrence  MissionRecurrence
  area        Area?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  progress    MissionProgress[]

  @@index([recurrence])
}

model MissionProgress {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionId   String
  mission     MissionDefinition @relation(fields: [missionId], references: [id], onDelete: Cascade)
  date        String
  progress    Int               @default(0)
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([userId, missionId, date])
  @@index([userId, date])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

// Generation request metadata
model GenerationRequest {
  id                    String   @id @default(cuid())
  requestId             String   @unique
  area                  Area
  dificultad            Dificultad
  tema                  String?
  plantilla             String?
  n                     Int      @default(1)
  status                GenerationStatus @default(PENDING)
  error                 String?
  rawModelOutput        String?  @db.Text         // Raw output from OpenAI (for debugging)
  parseStatus           ParseStatus?               // OK | FAIL
  parseError            String?                    // Parse error details
  normalizedItemsCount  Int      @default(0)       // Number of items parsed successfully
  items                 GeneratedItem[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([requestId])
  @@index([status])
  @@index([parseStatus])
  @@index([createdAt])
}

// Generated item (each question/item from AI)
model GeneratedItem {
  id                 String   @id @default(cuid())
  generationRequest  GenerationRequest @relation(fields: [requestId], references: [requestId], onDelete: Cascade)
  requestId          String
  area               Area
  dificultad         Dificultad
  plantilla          String
  contexto           String   @db.Text
  pregunta           String   @db.Text
  opciones           Json     // {A: string, B: string, C: string, D: string}
  respuesta_correcta String
  justificacion      String   @db.Text
  tags               Json     // array of strings
  distractores       Json     // {A: string, B: string, C: string, D: string} with error types
  explicaciones      Json?    // {A: string, B: string, C: string, D: string} with explanations
  /// {plantilla, parametros} for a diagram drawn from the item's own
  /// numbers. Stored as the spec, not as an image: fixing a template
  /// then fixes every item that uses it.
  figura             Json?

  // An item earns its place in the bank by being verified, and is reused
  // from there instead of being generated again.
  verified           Boolean  @default(false)
  verifierAnswer     String?  // what the independent solver answered
  verifierConfidence String?  // alta | media | baja
  // Normalised question text, hashed: catches an exact repeat for free,
  // before the cost of an embedding comparison.
  questionHash       String?
  // Embedding of the question, for near-duplicate detection via pgvector.
  // Unsupported because Prisma has no vector type; the column is real.
  embedding          Unsupported("vector(1536)")?
  timesServed        Int      @default(0)
  lastServedAt       DateTime?

  /// How the item performs with real learners.
  ///
  /// An item everyone gets right teaches nothing; one almost everyone
  /// gets wrong is usually badly written rather than hard. Without
  /// these numbers there is no way to tell the difference, and no
  /// evidence that the product works — which is what a paying customer
  /// is buying.
  vecesRespondido    Int      @default(0)
  vecesCorrecto      Int      @default(0)
  /// Milliseconds, summed: divided by vecesRespondido gives the mean.
  tiempoTotalMs      BigInt   @default(0)
  /// How often each option was chosen, as {A,B,C,D}. A distractor
  /// nobody ever picks is not doing its job.
  conteoOpciones     Json?
  /// Set when the numbers say the item is not usable, so it stops
  /// being served without being deleted.
  retirado           Boolean  @default(false)
  motivoRetiro       String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([requestId])
  @@index([area])
  @@index([createdAt])
  @@index([verified, area, dificultad])
  @@unique([questionHash])
}

/// A practice sitting that mirrors the real exam's proportions.
model Simulacro {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  /// Scored questions in this sitting, scaled from the real 254.
  totalPreguntas Int
  /// Minutes allowed, at the real exam's pace.
  minutos       Int
  status        SimulacroStatus @default(en_curso)
  startedAt     DateTime @default(now())
  finishedAt    DateTime?
  /// Score per area and overall, written when the sitting is graded.
  resultados    Json?

  preguntas     SimulacroPregunta[]

  @@index([userId, startedAt])
}

/// One question within a sitting, in the order it is presented.
model SimulacroPregunta {
  id           String   @id @default(cuid())
  simulacro    Simulacro @relation(fields: [simulacroId], references: [id], onDelete: Cascade)
  simulacroId  String
  itemId       String
  area         Area
  orden        Int
  /// What the learner chose, null until they answer.
  respuesta    String?
  correcta     Boolean?
  respondidaEn DateTime?

  @@unique([simulacroId, orden])
  @@index([simulacroId])
}

enum SimulacroStatus {
  en_curso
  terminado
  abandonado
}

/// A real item from an official booklet, used as an example when
/// generating a new one. Never served to a learner: it is the evidence
/// the generator reasons from, not practice material.
model ItemReferencia {
  id         String   @id @default(cuid())
  fuente     String   /// which booklet it came from
  numero     Int      /// its number in that booklet
  area       Area
  enunciado  String   @db.Text
  /// The shared passage, table or data the question asks about. ICFES
  /// prints one text above several questions, and without it a stem
  /// like "la palabra hurtaban puede sustituirse por" cannot be
  /// answered or imitated.
  contexto   String?  @db.Text
  opciones   Json
  /// True when the stimulus is a picture the extractor could not read,
  /// so the item is known to be incomplete rather than quietly wrong.
  necesitaFigura Boolean @default(false)
  /// Hash of the normalised stem, so re-running the extractor is safe.
  hash       String   @unique
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime @default(now())

  @@index([area])
}

/// One model request, with what it cost.
///
/// Pricing a subscription needs the cost of serving one learner, and
/// nothing recorded it. Written per request rather than aggregated, so
/// a surprising month can be traced to the operation that caused it.
model ConsumoLlm {
  id            String   @id @default(cuid())
  userId        String?  /// null for background work with no learner
  operacion     String   /// generar | verificar | embedding | retroalimentacion
  modelo        String
  tokensEntrada Int
  tokensSalida  Int
  /// Thousandths of a US cent, as an integer: floating point money
  /// drifts, and a single request can cost a fraction of a cent.
  costoMilicent Int
  exito         Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([operacion])
}
