// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enum for areas
enum Area {
  MAT
  LC
  CN
  SOC
  ING
}

// Enum for difficulty
enum Dificultad {
  facil
  media
  alta
}

// Enum for generation request status
enum GenerationStatus {
  PENDING
  SUCCESS
  ERROR
}

// Enum for parse status (debugging)
enum ParseStatus {
  OK
  FAIL
}

enum StudyMode {
  generacion_libre
  contrarreloj
  test
  /// A block of questions the study toll required before unblocking a
  /// distracting app. Its own mode rather than reusing `test`, because
  /// the whole point of the feature is to measure whether it works:
  /// a toll block and a voluntary practice session are not the same
  /// behaviour and must not average together.
  peaje
}

enum MissionType {
  questions_by_area
  review_explanations
  time_trial_sessions
  review_test
  sessions_completed
}

enum MissionRecurrence {
  daily
  weekly
}

/// What a learner's daily allowance is, which is the only thing a plan
/// changes today. The names match `Plan` in cuota.service.ts, because
/// two spellings of the same idea is how they drift apart.
///
/// `semilla` is for the accounts that stock the bank — filling it is a
/// few hundred items in an afternoon, which is exactly the shape the
/// free cap exists to stop. It raises the ceiling; it does not remove
/// it.
enum Plan {
  gratis
  pago
  semilla
}

model User {
  id              String           @id @default(cuid())
  email           String?          @unique
  passwordHash    String?
  passwordSalt    String?
  timezone        String           @default("UTC")
  /// Defaults to `gratis`, so an account that nobody has touched is
  /// metered: a plan that had to be set before it meant anything would
  /// make every new row unlimited until someone remembered.
  plan            Plan             @default(gratis)
  /// When the paid plan lapses. Null on a free account, and null on a
  /// paid one that does not expire. Checked rather than trusted: a row
  /// that says `pago` with a date in the past is a lapsed subscription,
  /// not a paying learner.
  planHasta       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  studySessions   StudySession[]
  xpEvents        XPEvent[]
  missionProgress MissionProgress[]
  refreshTokens   RefreshToken[]
  feedbacks       Feedback[]
  debilidades     PerfilDebilidad[]
  tutorias        Tutoria[]
  /// The name other learners see and search for. Null until chosen,
  /// because an account is useful without one: nothing outside duels
  /// reads it.
  ///
  /// Lowercased on write so the unique index is case-insensitive. Two
  /// learners called `Camilo` and `camilo` are indistinguishable on a
  /// screen, and a duel invitation that reached the wrong person would
  /// be worse than a rejected alias.
  alias           String?          @unique
  /// Whether this account may be found by alias search. A learner can
  /// turn it off and keep their alias: searchability and identity are
  /// separate decisions, and the one that exposes a minor to strangers
  /// is the one that should be revocable without losing the other.
  aliasBuscable   Boolean          @default(true)
  /// A line the learner writes about themselves, shown on their
  /// profile and to anyone who opens it from a friend list.
  ///
  /// Capped short on the way in. This is free text written by minors
  /// and read by other minors, so the length is part of the
  /// moderation surface: a bio long enough to hold a phone number and
  /// a plea is a bio long enough to be a problem, and 120 characters
  /// is enough to say «me falta física» and not much else.
  ///
  /// No separate public id: `alias` already is one. Two identifiers
  /// for the same person is a source of bugs and of mismatched
  /// moderation.
  descripcion     String?          @db.VarChar(120)
  /// Whether this account may read and act on the report queue.
  ///
  /// Granted once through `POST /moderacion/otorgar`, which is guarded
  /// by the server-side secret: the authority does not come from a row
  /// anyone with database access could write for themselves, and after
  /// that the moderator signs in like everyone else (ADR 34).
  ///
  /// Default false, and the one query that reads it is indexed, so a
  /// learner's own sign-in never pays for a feature they do not have.
  esModerador     Boolean          @default(false)
  /// When the role was granted. Kept because "who has this, and since
  /// when" is the first question asked when something goes wrong, and
  /// a boolean alone cannot answer it.
  moderadorDesde  DateTime?
  /// Confirmation that a parent or guardian authorised this account,
  /// required by Colombia's Ley 1581 de 2012 for a minor's personal
  /// data. Null means not given, which is why alias search is gated on
  /// it rather than on the alias existing.
  tutorAutorizoEn DateTime?
  duelosRetador   Duelo[]          @relation("retador")
  duelosRival     Duelo[]          @relation("rival")
  amistadesPedidas Amistad[]       @relation("pidio")
  amistadesRecibidas Amistad[]     @relation("recibio")
  bloqueosHechos  Bloqueo[]        @relation("bloqueador")
  bloqueosRecibidos Bloqueo[]      @relation("bloqueado")
  denunciasHechas Denuncia[]       @relation("denunciante")
  denunciasRecibidas Denuncia[]    @relation("denunciado")
  informesSemanales InformeSemanal[]

  @@index([createdAt])
  /// For the one query this pair exists to answer: which subscriptions
  /// have run out. Declared here rather than only in SQL — an index
  /// Prisma cannot see is an index Prisma will drop.
  @@index([plan, planHasta])
  /// Who moderates. A handful of rows out of all accounts, so the
  /// index is what keeps "list the moderators" from reading the table.
  @@index([esModerador])
  simulacros    Simulacro[]

}

model StudySession {
  id               String     @id @default(cuid())
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode             StudyMode
  area             Area
  dificultad       Dificultad?
  modeId           String?
  timeLimitSeconds Int?
  questions        Int?
  tema             String?
  startedAt        DateTime
  endedAt          DateTime
  durationSeconds  Int
  totalQuestions   Int
  correctQuestions Int
  correctXpAwarded Int        @default(0)
  timeXpAwarded    Int        @default(0)
  lastHeartbeatAt  DateTime?
  areaBreakdown    Json?
  answers          Answer[]
  feedback         Feedback?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([userId, endedAt])
  @@index([userId, area])
  @@index([userId, mode])
}

model TimeTrialMode {
  id              String   @id
  title           String
  description     String
  timeLimitSeconds Int
  questions       Int
  /// Null means "aim at whatever this learner is weakest in", which is
  /// the point of having a weakness profile at all.
  area            Area?
  dificultad      Dificultad?
  mix             Json?
  /// Where this sits in the ladder, so the interface can show how far
  /// along someone is instead of a flat list.
  nivel           Int      @default(1)
  /// Derived, but stored so the interface can show the pace without
  /// dividing, and so a mode cannot drift from what it claims.
  segundosPorPregunta Int  @default(64)
  enabled         Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([enabled])
}

model Feedback {
  id           String   @id @default(cuid())
  sessionId    String   @unique
  session      StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  summary      String
  strengths    Json
  weaknesses   Json
  plan         Json
  insights     Json
  generatedAt  DateTime
  model        String
  promptVersion String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, generatedAt])
}

model Answer {
  id             String       @id @default(cuid())
  sessionId      String
  session        StudySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionIndex  Int
  area           Area?
  dificultad     Dificultad?
  selectedAnswer String?
  isCorrect      Boolean
  /// Which item was answered. Without it the answer cannot be joined
  /// back to the question's topic or to the kind of mistake the chosen
  /// option represents, which is everything the weakness profile needs.
  /// Nullable because answers recorded before this existed have none.
  itemId         String?
  /// How long the learner took. A correct answer that took three
  /// minutes is not the same as one that took twenty seconds.
  tiempoMs       Int?
  createdAt      DateTime     @default(now())

  @@index([sessionId])
  @@index([itemId])
  /// The weekly report groups answers by topic inside a seven-day
  /// window, which without this is a sequential scan of every answer
  /// ever recorded — fine at thirteen rows, and the slowest query in
  /// the service after a year of use. Verified with EXPLAIN: the plan
  /// went from `Seq Scan on Answer` to an index scan.
  @@index([createdAt])
}

/// What a learner keeps getting wrong, and at what grain.
///
/// StudySession already says how a learner did in an area. That is too
/// coarse to act on: "flojo en Matemáticas" does not say whether the
/// problem is angles or percentages, and the whole point is to put the
/// right thing in front of them tomorrow.
///
/// One row per learner, area and topic. `tipoErrores` counts how often
/// each kind of mistake appeared — error_calculo,
/// interpretacion_parcial, confunde_conceptos — which the generator
/// already labels on every distractor and which was being thrown away.
model PerfilDebilidad {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  area         Area
  /// The topic, from the item's own tags: "angulos", "leyes de newton".
  tema         String
  respondidas  Int      @default(0)
  acertadas    Int      @default(0)
  /// {error_calculo: 3, confunde_conceptos: 1}
  tipoErrores  Json     @default("{}")
  /// Lets a weakness fade: what someone failed in March should not
  /// outrank what they failed last week.
  ultimoFallo  DateTime?
  actualizadoEn DateTime @updatedAt

  @@unique([userId, area, tema])
  @@index([userId, area])
}

/// A conversation about one question the learner got wrong.
///
/// Tied to the learner and the item, not to the session: someone who
/// fails the same question twice should meet the same conversation,
/// with the tutor remembering what was already said. Starting over
/// each time would make the second explanation identical to the first,
/// which is exactly what did not work the first time.
model Tutoria {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The GeneratedItem being discussed.
  itemId    String
  /// What the learner first chose. Kept because the conversation is
  /// about that specific mistake, even after they answer correctly.
  opcionElegida String
  /// Their own account of why they chose it, asked for before the
  /// tutor says anything. Verbalising the reasoning is where the
  /// mistake becomes visible, to them and to us.
  defensa   String?  @db.Text
  mensajes  TutoriaMensaje[]
  /// True once they answered the question correctly afterwards.
  resuelto  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, itemId])
  @@index([userId])
}

model TutoriaMensaje {
  id        String   @id @default(cuid())
  tutoriaId String
  tutoria   Tutoria  @relation(fields: [tutoriaId], references: [id], onDelete: Cascade)
  /// 'estudiante' or 'tutor'.
  autor     String
  contenido String   @db.Text
  createdAt DateTime @default(now())

  @@index([tutoriaId])
}

model XPEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    String
  meta      Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model MissionDefinition {
  id          String            @id @default(cuid())
  title       String
  description String?
  type        MissionType
  target      Int
  xpReward    Int
  recurrence  MissionRecurrence
  area        Area?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  progress    MissionProgress[]

  @@index([recurrence])
}

model MissionProgress {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionId   String
  mission     MissionDefinition @relation(fields: [missionId], references: [id], onDelete: Cascade)
  date        String
  progress    Int               @default(0)
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([userId, missionId, date])
  @@index([userId, date])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

// Generation request metadata
model GenerationRequest {
  id                    String   @id @default(cuid())
  requestId             String   @unique
  area                  Area
  dificultad            Dificultad
  tema                  String?
  plantilla             String?
  n                     Int      @default(1)
  status                GenerationStatus @default(PENDING)
  error                 String?
  rawModelOutput        String?  @db.Text         // Raw output from OpenAI (for debugging)
  parseStatus           ParseStatus?               // OK | FAIL
  parseError            String?                    // Parse error details
  normalizedItemsCount  Int      @default(0)       // Number of items parsed successfully
  items                 GeneratedItem[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([requestId])
  @@index([status])
  @@index([parseStatus])
  @@index([createdAt])
}

// Generated item (each question/item from AI)
model GeneratedItem {
  id                 String   @id @default(cuid())
  generationRequest  GenerationRequest @relation(fields: [requestId], references: [requestId], onDelete: Cascade)
  requestId          String
  area               Area
  dificultad         Dificultad
  plantilla          String
  contexto           String   @db.Text
  pregunta           String   @db.Text
  opciones           Json     // {A: string, B: string, C: string, D: string}
  respuesta_correcta String
  justificacion      String   @db.Text
  tags               Json     // array of strings
  distractores       Json     // {A: string, B: string, C: string, D: string} with error types
  explicaciones      Json?    // {A: string, B: string, C: string, D: string} with explanations
  /// {plantilla, parametros} for a diagram drawn from the item's own
  /// numbers. Stored as the spec, not as an image: fixing a template
  /// then fixes every item that uses it.
  figura             Json?

  // An item earns its place in the bank by being verified, and is reused
  // from there instead of being generated again.
  verified           Boolean  @default(false)
  verifierAnswer     String?  // what the independent solver answered
  verifierConfidence String?  // alta | media | baja
  // Normalised question text, hashed: catches an exact repeat for free,
  // before the cost of an embedding comparison.
  questionHash       String?
  // Embedding of the question, for near-duplicate detection via pgvector.
  // Unsupported because Prisma has no vector type; the column is real.
  embedding          Unsupported("vector(1536)")?
  timesServed        Int      @default(0)
  lastServedAt       DateTime?

  /// How the item performs with real learners.
  ///
  /// An item everyone gets right teaches nothing; one almost everyone
  /// gets wrong is usually badly written rather than hard. Without
  /// these numbers there is no way to tell the difference, and no
  /// evidence that the product works — which is what a paying customer
  /// is buying.
  vecesRespondido    Int      @default(0)
  vecesCorrecto      Int      @default(0)
  /// Milliseconds, summed: divided by vecesRespondido gives the mean.
  tiempoTotalMs      BigInt   @default(0)
  /// How often each option was chosen, as {A,B,C,D}. A distractor
  /// nobody ever picks is not doing its job.
  conteoOpciones     Json?
  /// Set when the numbers say the item is not usable, so it stops
  /// being served without being deleted.
  retirado           Boolean  @default(false)
  motivoRetiro       String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([requestId])
  @@index([area])
  @@index([createdAt])
  @@index([verified, area, dificultad])
  @@unique([questionHash])
}

/// A practice sitting that mirrors the real exam's proportions.
model Simulacro {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  /// Scored questions in this sitting, scaled from the real 254.
  totalPreguntas Int
  /// Minutes allowed, at the real exam's pace.
  minutos       Int
  status        SimulacroStatus @default(en_curso)
  startedAt     DateTime @default(now())
  finishedAt    DateTime?
  /// Score per area and overall, written when the sitting is graded.
  resultados    Json?

  preguntas     SimulacroPregunta[]

  @@index([userId, startedAt])
}

/// One question within a sitting, in the order it is presented.
model SimulacroPregunta {
  id           String   @id @default(cuid())
  simulacro    Simulacro @relation(fields: [simulacroId], references: [id], onDelete: Cascade)
  simulacroId  String
  itemId       String
  area         Area
  orden        Int
  /// What the learner chose, null until they answer. It can change:
  /// in the real exam you may go back and pick another option, and
  /// only the last choice counts.
  respuesta    String?
  correcta     Boolean?
  respondidaEn DateTime?
  /// Flagged by the learner to come back to, like the scratch sheet
  /// they are given in the real sitting. It says nothing about whether
  /// the question is answered — both states are independent, and both
  /// show on the map.
  marcada      Boolean  @default(false)

  @@unique([simulacroId, orden])
  @@index([simulacroId])
}

enum SimulacroStatus {
  en_curso
  terminado
  abandonado
}

/// A real item from an official booklet, used as an example when
/// generating a new one. Never served to a learner: it is the evidence
/// the generator reasons from, not practice material.
model ItemReferencia {
  id         String   @id @default(cuid())
  fuente     String   /// which booklet it came from
  numero     Int      /// its number in that booklet
  area       Area
  enunciado  String   @db.Text
  /// The shared passage, table or data the question asks about. ICFES
  /// prints one text above several questions, and without it a stem
  /// like "la palabra hurtaban puede sustituirse por" cannot be
  /// answered or imitated.
  contexto   String?  @db.Text
  opciones   Json
  /// True when the stimulus is a picture the extractor could not read,
  /// so the item is known to be incomplete rather than quietly wrong.
  necesitaFigura Boolean @default(false)
  /// Hash of the normalised stem, so re-running the extractor is safe.
  hash       String   @unique
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime @default(now())

  @@index([area])
}

/// One model request, with what it cost.
///
/// Pricing a subscription needs the cost of serving one learner, and
/// nothing recorded it. Written per request rather than aggregated, so
/// a surprising month can be traced to the operation that caused it.
model ConsumoLlm {
  id            String   @id @default(cuid())
  userId        String?  /// null for background work with no learner
  operacion     String   /// generar | verificar | embedding | retroalimentacion
  modelo        String
  tokensEntrada Int
  tokensSalida  Int
  /// Thousandths of a US cent, as an integer: floating point money
  /// drifts, and a single request can cost a fraction of a cent.
  costoMilicent Int
  exito         Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([operacion])
}

enum DueloEstado {
  /// Invited, and the rival has not accepted yet.
  pendiente
  /// Both accepted. Each plays when they can.
  en_curso
  /// Both finished. `ganadorId` is set, or null for a tie.
  terminado
  /// Declined, expired, or cancelled. Kept rather than deleted so a
  /// learner's own history stays whole.
  cancelado
}

/// An asynchronous 1v1 duel over the same five questions.
///
/// Asynchronous on purpose: live play needs both learners present at
/// the same minute, which for someone balancing school and the ICFES
/// means never. Each plays when they can, and the result is settled
/// when the second one finishes.
///
/// The questions are fixed at creation and stored here, not drawn per
/// player. A duel where each player got different questions would be
/// a comparison of luck.
model Duelo {
  id          String      @id @default(cuid())
  /// Who sent the invitation.
  retador     User        @relation("retador", fields: [retadorId], references: [id], onDelete: Cascade)
  retadorId   String
  /// Who received it. Set at creation: an invitation with no recipient
  /// is an open lobby, which is what alias search exists to avoid.
  rival       User        @relation("rival", fields: [rivalId], references: [id], onDelete: Cascade)
  rivalId     String
  estado      DueloEstado @default(pendiente)
  /// The five item ids, in the order both players see them.
  itemIds     String[]
  /// Correct answers and elapsed seconds per player, written as each
  /// one finishes. Json rather than columns because a duel is read
  /// whole and never queried by these numbers.
  resultadoRetador Json?
  resultadoRival   Json?
  /// Null while unfinished, and null for a tie on both counts.
  ganadorId   String?
  creadoEn    DateTime    @default(now())
  /// When the invitation stops being acceptable. An invitation that
  /// never expires leaves a notification a learner cannot clear.
  expiraEn    DateTime
  terminadoEn DateTime?

  /// The two lists a learner opens: duels they started and duels they
  /// were invited to, newest first.
  @@index([retadorId, creadoEn])
  @@index([rivalId, estado])
}

/// One learner refusing contact from another.
///
/// Checked on search, on invitation and on delivery, not only on
/// search: a block that only hides someone from a list still lets a
/// held invitation through.
model Bloqueo {
  id            String   @id @default(cuid())
  bloqueador    User     @relation("bloqueador", fields: [bloqueadorId], references: [id], onDelete: Cascade)
  bloqueadorId  String
  bloqueado     User     @relation("bloqueado", fields: [bloqueadoId], references: [id], onDelete: Cascade)
  bloqueadoId   String
  creadoEn      DateTime @default(now())

  /// One row per pair. Blocking twice is the same as blocking once.
  @@unique([bloqueadorId, bloqueadoId])
  @@index([bloqueadorId])
}

enum DenunciaMotivo {
  alias_ofensivo
  acoso
  suplantacion
  otro
}

enum DenunciaEstado {
  abierta
  revisada
  descartada
}

/// A report about another learner, for a human to read.
///
/// Stored rather than emailed because a report that arrives as a
/// notification gets lost, and because the same alias reported by
/// three different learners is a signal no single message carries.
model Denuncia {
  id             String         @id @default(cuid())
  denunciante    User           @relation("denunciante", fields: [denuncianteId], references: [id], onDelete: Cascade)
  denuncianteId  String
  denunciado     User           @relation("denunciado", fields: [denunciadoId], references: [id], onDelete: Cascade)
  denunciadoId   String
  motivo         DenunciaMotivo
  /// What the learner wrote, trimmed and capped by the route.
  detalle        String?
  estado         DenunciaEstado @default(abierta)
  creadoEn       DateTime       @default(now())
  revisadoEn     DateTime?

  /// For the one query moderation runs: what is still open, oldest
  /// first, and everything reported about one account.
  @@index([estado, creadoEn])
  @@index([denunciadoId])
}

enum EstadoDeAmistad {
  /// Asked, and the other learner has not answered yet.
  pendiente
  aceptada
  /// Declined. Kept rather than deleted so the same person cannot
  /// re-ask every day: a refused request that vanishes is a way to
  /// pester someone through an ordinary feature.
  rechazada
}

/// Two learners who duel each other often enough to not want the search box.
///
/// **Mutual by construction.** A one-sided friend list would let a
/// stranger add a minor and challenge them without that minor ever
/// agreeing to anything — which is the surface alias search already
/// has to justify, and there is no reason to add a second one.
///
/// The pair is stored in the order it was asked, and every read looks
/// at both directions. Normalising the pair (smaller id first) would
/// make the queries simpler and lose who asked whom, which is exactly
/// what the pending state needs to know.
model Amistad {
  id         String          @id @default(cuid())
  pidio      User            @relation("pidio", fields: [pidioId], references: [id], onDelete: Cascade)
  pidioId    String
  recibio    User            @relation("recibio", fields: [recibioId], references: [id], onDelete: Cascade)
  recibioId  String
  estado     EstadoDeAmistad @default(pendiente)
  creadoEn   DateTime        @default(now())
  resueltaEn DateTime?

  /// One row per ordered pair: asking twice is asking once.
  @@unique([pidioId, recibioId])
  /// The two lists a learner opens: who they asked, and who asked them.
  @@index([pidioId, estado])
  @@index([recibioId, estado])
}

/// What this learner is carrying, written once a week.
///
/// Not the same thing as `Feedback`, which is a post-mortem of one
/// session: that one answers "how did those eight questions go", and
/// a learner who wants to know where they stand cannot get it by
/// reading twenty of them.
///
/// **The model does not work out the weaknesses. It writes them up.**
/// `DebilidadesService.temasDebiles` already returns them per topic,
/// with the typical mistake and a priority that decays with age, and
/// it is deterministic and tested. A report where the model inferred
/// "you are weak at angles" from raw answers is a report that lies the
/// first time it infers wrong, and the learner notices in the opening
/// sentence. So the numbers arrive already computed and `datos` keeps
/// exactly what was handed over, which is how "where did it get that"
/// gets answered without calling the model again.
model InformeSemanal {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Monday 00:00 in the learner's own timezone, stored as UTC. The
  /// week is the unit of idempotency: two requests on the same Tuesday
  /// return one report, not two invoices. This is what `sessionId
  /// @unique` does for `Feedback`.
  semanaInicio  DateTime
  resumen       String
  /// [{area?, nota}] — the shape `FeedbackResponseSchema` already uses,
  /// so one screen can render either.
  fortalezas    Json
  debilidades   Json
  /// [{area, tema, titulo, detalle}]. `area` and `tema` are the ones
  /// the server supplied, never ones the model chose: they are the key
  /// contrarreloj and entrenar use to ask for exercises afterwards, and
  /// a topic the bank has never heard of would return nothing.
  plan          Json
  /// What was handed to the model, kept verbatim.
  datos         Json
  generadoEn    DateTime @default(now())
  modelo        String
  promptVersion String

  /// One report per learner per week. The week is the idempotency key,
  /// so a second request inside it reads instead of spending.
  @@unique([userId, semanaInicio])
  @@index([userId, generadoEn])
}
